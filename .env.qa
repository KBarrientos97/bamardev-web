# Usado por `npm run build:qa` (vite build --mode qa).
VITE_API_URL=https://api-qa.bamardev.com/api

# Telemetría de errores (PostHog, proyecto 573068 — el mismo de Android y el
# backend). La key de proyecto NO es secreta: es de escritura y viaja en el
# bundle, igual que la de la app. Sin ella el módulo queda inerte.
VITE_POSTHOG_KEY=phc_tnYcP5xWRdiqAyDo6wQaHQLSB42eH5YEq4Wfsv4pEKG5
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Cloudflare Turnstile (captcha de la reserva online). La site key NO es
# secreta: viaja en el HTML, como la de PostHog. La secreta vive sólo en el VPS
# (TURNSTILE_SECRET). Sin esta variable no se dibuja el widget ni se manda token.
# QA usa la pareja de PRUEBA de Cloudflare desde el 13-nov-2026: la site key
# 1x00000000000000000000AA aprueba siempre y en el VPS BAMAR_QA_TURNSTILE_SECRET
# es la secreta de prueba. Asi los agentes y el navegador automatizado pueden
# crear pedidos y reservas en QA (el widget real los frena). La secreta real
# quedo en /opt/stack/.env.bak-antes-turnstile-prueba-qa-20261113 y la site key
# real, en el historial de git de este archivo (CONFIG-PROD).
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
