# Cabeceras de Cloudflare Pages para las páginas del cliente final (B19 de la
# ronda 1 de QA). La app (POS) no cambia: sólo /r/* y /p/*.
#
# /r/* es la reserva online, y /r/<sub>/c/<token> lleva el token secreto del
# enlace de gestión en la URL:
#   · noindex: que ningún buscador la guarde;
#   · no-referrer: un clic a WhatsApp, Maps o al teléfono no le pasa la URL
#     (con el token) a otro sitio;
#   · sin marcos: "Cancelar mi cita" no se puede enmarcar en otra página para
#     hacer clic a escondidas (clickjacking).
/r/*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'

# La página del negocio sí se puede indexar (es su vitrina), pero tampoco se
# enmarca, y hacia afuera sólo viaja el origen.
/p/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
