# Leído por wrangler al desplegar (Pages no permite account_id en wrangler.jsonc).
# Cuenta de Cloudflare de Kevin (Kevinbamar97) — igual que el panel y la landing.
# Vite NO expone esta variable al cliente (no tiene prefijo VITE_).
CLOUDFLARE_ACCOUNT_ID=5646b8d2dc504e8fd952857a5b7a6bf9
# En dev dejamos VITE_API_URL vacío a propósito: el cliente pega a /api y el
# proxy de Vite lo reenvía a QA (evita el CORS de localhost).
VITE_API_URL=

# En dev queda vacío a propósito: los errores de un `npm run dev` no tienen que
# ensuciar el tablero. Para probar la telemetría, poné acá la key de QA.
VITE_POSTHOG_KEY=
